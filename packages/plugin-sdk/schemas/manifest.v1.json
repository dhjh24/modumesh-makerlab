{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modumesh.local/schemas/plugin-manifest.v1.json",
  "title": "ModuMesh MakerLab Plugin Manifest",
  "description": "Versioned plugin contract (schemaVersion 1). Plugins are untrusted; manifests declare capability bounds enforced by the host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "sdkVersion",
    "engine",
    "entrypoint",
    "categories",
    "outputs",
    "timeoutSeconds",
    "memoryMb",
    "networkPolicy",
    "inputSchema"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1",
      "description": "Manifest schema major version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Stable plugin identifier (lowercase kebab-case)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9]+)*$",
      "description": "SemVer plugin version."
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "ModuMesh plugin SDK version this plugin targets."
    },
    "engine": {
      "type": "string",
      "enum": ["python"],
      "description": "Execution engine. CadQuery plugins also use engine=python."
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Python entrypoint as module:function."
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mediaType"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "description": "Filename relative to the job work directory (no path separators)."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "application/json",
              "text/plain",
              "text/csv",
              "application/octet-stream",
              "image/png",
              "model/stl",
              "model/step",
              "model/obj",
              "model/gltf-binary"
            ]
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "memoryMb": {
      "type": "integer",
      "minimum": 32,
      "maximum": 4096
    },
    "networkPolicy": {
      "type": "string",
      "enum": ["deny", "allow"],
      "default": "deny",
      "description": "Network access. Default and recommended: deny."
    },
    "inputSchema": {
      "description": "Inline JSON Schema object, or relative path to a schema file inside the plugin directory.",
      "oneOf": [
        { "type": "object", "minProperties": 1 },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.json$",
          "maxLength": 255
        }
      ]
    },
    "maxInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "default": 65536
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600,
      "default": 1048576
    }
  }
}
