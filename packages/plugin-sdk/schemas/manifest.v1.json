{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modumesh.local/schemas/plugin-manifest.v1.json",
  "title": "ModuMesh MakerLab Plugin Manifest",
  "description": "Versioned plugin contract (schemaVersion 1). Plugins are untrusted; manifests declare capability bounds enforced by the host. Additive marketplace fields (author, license, capabilities, etc.) are optional for backward compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "sdkVersion",
    "engine",
    "entrypoint",
    "categories",
    "outputs",
    "timeoutSeconds",
    "memoryMb",
    "networkPolicy",
    "inputSchema"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1",
      "description": "Manifest schema major version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Stable plugin identifier (lowercase kebab-case)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9]+)*$",
      "description": "SemVer plugin version."
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "ModuMesh plugin SDK version this plugin targets."
    },
    "engine": {
      "type": "string",
      "enum": ["python"],
      "description": "Execution engine. CadQuery plugins also use engine=python."
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Python entrypoint as module:function."
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mediaType"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "description": "Filename relative to the job work directory (no path separators)."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "application/json",
              "text/plain",
              "text/csv",
              "application/octet-stream",
              "image/png",
              "image/svg+xml",
              "model/stl",
              "model/step",
              "model/obj",
              "model/gltf-binary",
              "model/3mf"
            ]
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "purpose": {
            "type": "string",
            "enum": ["printable", "preview", "thumbnail", "metadata", "source"],
            "description": "What the output artifact is used for (marketplace field)."
          }
        }
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "memoryMb": {
      "type": "integer",
      "minimum": 32,
      "maximum": 4096
    },
    "networkPolicy": {
      "type": "string",
      "enum": ["deny", "allow"],
      "default": "deny",
      "description": "Network access. Default and recommended: deny."
    },
    "inputSchema": {
      "description": "Inline JSON Schema object, or relative path to a schema file inside the plugin directory.",
      "oneOf": [
        { "type": "object", "minProperties": 1 },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.json$",
          "maxLength": 255
        }
      ]
    },
    "maxInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "default": 65536
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600,
      "default": 1048576
    },

    "─ Marketplace fields (all optional) ─────────────────────": {},

    "author": {
      "type": "string",
      "maxLength": 255,
      "description": "Plugin author name or GitHub handle."
    },
    "license": {
      "type": "string",
      "maxLength": 64,
      "description": "SPDX license identifier (e.g. MIT, Apache-2.0). Omitted or unknown → quarantined."
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "URL to the full license text."
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "Public source repository URL."
    },
    "maturity": {
      "type": "string",
      "enum": ["experimental", "stable", "deprecated"],
      "default": "experimental",
      "description": "Development maturity level."
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    },
    "thumbnail": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.(png|webp)$",
      "maxLength": 255,
      "description": "Relative path to a thumbnail image inside the plugin directory."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preview": { "type": "boolean", "default": false },
        "deterministic": { "type": "boolean", "default": false },
        "multipart": { "type": "boolean", "default": false },
        "multicolor": { "type": "boolean", "default": false },
        "text": { "type": "boolean", "default": false },
        "imageUpload": { "type": "boolean", "default": false },
        "shopReady": { "type": "boolean", "default": false }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdk": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "worker": { "type": "string", "maxLength": 255 }
      }
    }
  }
}
