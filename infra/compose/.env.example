# ─── ModuMesh MakerLab — Compose environment (infra/compose/.env) ─────────
# Copy this file to infra/compose/.env and fill in your values:
#   cp infra/compose/.env.example infra/compose/.env
# NEVER commit .env (gitignored). The repo-root .env.example is the
# app-level reference (API/worker/web settings); THIS file is what
# `docker compose` actually interpolates for the stack in
# infra/compose/docker-compose.yml. Invoke the stack with
# `docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.yml …`
# (compose also auto-loads .env from the project directory).
#
# Every key below mirrors a ${VAR:-default} usage in docker-compose.yml.
# In CI, this example is copied to infra/compose/.env and the datastore
# secrets are replaced with fresh random values (`openssl rand -hex 32`)
# before the smoke stack starts — see .github/workflows/ci.yml (M20).

# ── Datastores (internal network only; no host ports) ────────────────────
POSTGRES_DB=modumesh
POSTGRES_USER=modumesh
# Must be a strong random value whenever API_ENV != development — the API
# refuses to boot otherwise (fail-closed, GM-12 D1.2).
POSTGRES_PASSWORD=change_me_in_production

# Redis requirepass (GM-12 D1.1). Empty = no password (local dev only).
# MUST be a strong random value when API_ENV != development; the redis
# service runs `redis-server --requirepass ${REDIS_PASSWORD}` and the
# API/worker connect with it.
REDIS_PASSWORD=

MINIO_ACCESS_KEY=modumesh
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=modumesh-models

# ── API ──────────────────────────────────────────────────────────────────
# Deployment environment: development (default) | ci | staging | production.
# Non-development: fail-closed secret validation + /docs & /openapi.json
# disabled (GM-12 D1.2/D1.4). CI smoke stack sets API_ENV=ci.
API_ENV=development
# Alembic as an explicit deploy step: 1 = run `alembic upgrade head` in-app
# at boot; 0 = never (run it manually / via CI before the API starts).
API_RUN_MIGRATIONS=0
# Optional bearer token for GET /api/v1/metrics (empty = no auth; endpoint
# is internal-network only).
API_METRICS_TOKEN=
# Comma-separated CIDRs of reverse proxies trusted to supply
# X-Forwarded-For (empty = never trust the header).
API_TRUSTED_PROXIES=
# Rate limiting — keep "false" in CI/local smoke stacks.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_RPM=60
API_JOB_RATE_LIMIT_RPM=10
# CORS origins (comma-separated). Same-origin via Caddy in production.
API_CORS_ORIGINS=https://makerlab.example.com

# ── Admin (fail-closed) ──────────────────────────────────────────────────
# The API refuses to start when ADMIN_API_KEY is empty or
# ADMIN_PLUGIN_SIGNING_SECRET is the default "dev-secret".
# Generate with `openssl rand -hex 32`.
ADMIN_API_KEY=change_me_to_a_long_random_string
ADMIN_PLUGIN_SIGNING_SECRET=change_me_to_another_long_random_string

# ── Host bindings / images ───────────────────────────────────────────────
# Host port the API container's 8000 is mapped to (default 8002).
MAKERLAB_API_HOST_PORT=8002
# Image tag for locally built api/worker images (CI uses its own project
# name and builds with --pull).
MAKERLAB_IMAGE_TAG=local

# ── Backups (GM-12 D2) ───────────────────────────────────────────────────
# Retention window (days) for pruned backup artifacts.
BACKUP_RETENTION_DAYS=14
