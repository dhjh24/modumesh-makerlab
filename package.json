{
  "name": "modumesh-makerlab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted 3D generator platform — schema-driven plugins, queued CAD generation, model validation, browser preview",
  "workspaces": [
    "apps/web",
    "packages/plugin-sdk",
    "packages/shared-types",
    "packages/viewer",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
