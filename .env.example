# ─── ModuMesh MakerLab Environment ───────────────────────────────────────
# Copy this file to .env and fill in your values.  Never commit .env.

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modumesh
POSTGRES_USER=modumesh
POSTGRES_PASSWORD=modumesh_dev_pass

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO ───────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=modumesh_dev
MINIO_SECRET_KEY=modumesh_dev_secret
MINIO_BUCKET=modumesh-models
MINIO_SECURE=false

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info
API_VERSION=0.1.0
API_AUTH_ENABLED=true
API_BOOTSTRAP_ADMIN_USERNAME=admin
API_BOOTSTRAP_ADMIN_PASSWORD=change_me_admin
API_SESSION_TTL_HOURS=24
API_SESSION_COOKIE_SECURE=false
API_SESSION_COOKIE_SAMESITE=lax
API_DOWNLOAD_SIGNING_SECRET=change_me_download_secret
API_DOWNLOAD_URL_TTL_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_AUTH_PER_MINUTE=20
API_MAX_REQUEST_BYTES=1048576
API_RETENTION_DAYS=90
API_METRICS_ENABLED=true
API_DOCS_ENABLED=true
API_STORAGE_TEST_ENABLED=false

# ── Worker ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_PLUGIN_TIMEOUT_SECONDS=300
WORKER_MAX_MEMORY_MB=2048
WORKER_LOG_LEVEL=info
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_REAPER_INTERVAL_SECONDS=15
WORKER_SAMPLE_STEP_DELAY_MS=200

# ── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Plugins ─────────────────────────────────────────────────────────────
API_PLUGIN_DIR=/plugins
WORKER_PLUGIN_DIR=/plugins
