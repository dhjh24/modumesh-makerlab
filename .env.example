# ─── ModuMesh MakerLab Environment ───────────────────────────────────────
# Copy this file to .env and fill in your values.  Never commit .env.

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modumesh
POSTGRES_USER=modumesh
POSTGRES_PASSWORD=change_me_in_production

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO ───────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=modumesh
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=modumesh-models

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info

# ── Worker ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_PLUGIN_TIMEOUT_SECONDS=300
WORKER_MAX_MEMORY_MB=512

# ── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
