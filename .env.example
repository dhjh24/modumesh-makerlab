# ─── ModuMesh MakerLab Environment ───────────────────────────────────────
# Copy this file to .env and fill in your values.  Never commit .env.
#
# ── DEVELOPMENT vs PRODUCTION ───────────────────────────────────────────
#
# Production (Caddy reverse proxy, same-origin API):
#   Set NEXT_PUBLIC_API_URL="" (empty = browser uses /api/v1/… rewrites)
#   Caddy proxies /api/v1/* → api:8000
#   API_CORS_ORIGINS=https://your-production-domain.com
#
# LAN development (direct from another device):
#   NEXT_PUBLIC_API_URL=http://YOUR_SERVER_LAN_IP:8002
#   API_CORS_ORIGINS=http://YOUR_SERVER_LAN_IP:3002
#   MAKERLAB_API_HOST_PORT=8002
#
# Local all-in-one machine (browser + server same machine):
#   NEXT_PUBLIC_API_URL=http://localhost:8002
#   API_CORS_ORIGINS=http://localhost:3002
#   MAKERLAB_API_HOST_PORT=8002

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modumesh
POSTGRES_USER=modumesh
POSTGRES_PASSWORD=modumesh_dev_pass

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO ───────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=modumesh_dev
MINIO_SECRET_KEY=modumesh_dev_secret
MINIO_BUCKET=modumesh-models
MINIO_SECURE=false

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# CORS: comma-separated. Empty or missing means no CORS headers set.
# Production (same-origin via Caddy): set to your HTTPS domain.
# LAN dev: http://SERVER_LAN_IP:3002
# The API container always listens on internal port 8000.
API_CORS_ORIGINS=https://makerlab.example.com
API_LOG_LEVEL=info
API_VERSION=0.1.0

# ── Worker ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_PLUGIN_TIMEOUT_SECONDS=300
WORKER_MAX_MEMORY_MB=512
WORKER_LOG_LEVEL=info
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_REAPER_INTERVAL_SECONDS=15
WORKER_SAMPLE_STEP_DELAY_MS=200

# ── Web ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL controls the browser-side API fetch base URL.
#
# PRODUCTION (with Caddy reverse proxy):
#   Set to "" (empty) → browser uses same-origin /api/v1/…
#   This requires Caddy or your reverse proxy to route /api/v1/* → api:8000
#   and * → web:3000.
#
# LOCAL DEV (browser + server on same machine):
#   NEXT_PUBLIC_API_URL=http://localhost:8002
#
# LAN DEV (browser on separate device):
#   NEXT_PUBLIC_API_URL=http://SERVER_LAN_IP:8002
NEXT_PUBLIC_API_URL=

# Host port the API container's port 8000 is mapped to.
# Default 8002 — avoids conflict with other services on port 8000.
MAKERLAB_API_HOST_PORT=8002

# ── Plugins ─────────────────────────────────────────────────────────────
API_PLUGIN_DIR=/plugins
WORKER_PLUGIN_DIR=/plugins
