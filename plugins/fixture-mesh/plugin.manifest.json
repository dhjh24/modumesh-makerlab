{
  "schemaVersion": "1",
  "id": "fixture-mesh",
  "name": "Fixture Mesh",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "engine": "python",
  "entrypoint": "fixture_mesh.plugin:run",
  "description": "Non-CAD fixture plugin that emits packaged STL/GLB assets for viewer testing.",
  "license": "MIT",
  "author": "MakerLab Team",
  "categories": [
    "fixture",
    "testing",
    "mesh"
  ],
  "outputs": [
    {
      "name": "model.stl",
      "mediaType": "model/stl",
      "required": false
    },
    {
      "name": "model.glb",
      "mediaType": "model/gltf-binary",
      "required": false
    },
    {
      "name": "meta.json",
      "mediaType": "application/json",
      "required": true
    }
  ],
  "timeoutSeconds": 30,
  "memoryMb": 128,
  "networkPolicy": "deny",
  "inputSchema": "input.schema.json",
  "maxInputBytes": 65536,
  "maxOutputBytes": 1048576
}
