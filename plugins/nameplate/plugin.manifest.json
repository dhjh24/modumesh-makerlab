{
  "schemaVersion": "1",
  "id": "nameplate",
  "name": "Nameplate",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "engine": "python",
  "entrypoint": "nameplate.plugin:run",
  "description": "Parametric CadQuery nameplate with raised or engraved text, optional mounting holes, and validated STL/STEP/GLB/PNG outputs.",
  "categories": ["cad", "signage", "reference"],
  "outputs": [
    {
      "name": "model.stl",
      "mediaType": "model/stl",
      "required": true
    },
    {
      "name": "model.step",
      "mediaType": "model/step",
      "required": true
    },
    {
      "name": "model.glb",
      "mediaType": "model/gltf-binary",
      "required": true
    },
    {
      "name": "thumbnail.png",
      "mediaType": "image/png",
      "required": true
    },
    {
      "name": "metadata.json",
      "mediaType": "application/json",
      "required": true
    }
  ],
  "timeoutSeconds": 180,
  "memoryMb": 2048,
  "networkPolicy": "deny",
  "inputSchema": "input.schema.json",
  "maxInputBytes": 65536,
  "maxOutputBytes": 16777216
}
