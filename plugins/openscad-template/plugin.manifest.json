{
  "schemaVersion": "1",
  "id": "openscad-template",
  "name": "OpenSCAD Storage Box",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "engine": "python",
  "entrypoint": "openscad_template.plugin:run",
  "description": "Generate parametric storage boxes and grid organizers using OpenSCAD. Parameters generate safe .scad definition files \u2014 never accepts raw user script input.",
  "license": "MIT",
  "author": "MakerLab Team",
  "categories": [
    "cad",
    "parametric",
    "openscad",
    "container"
  ],
  "outputs": [
    {
      "name": "model.stl",
      "mediaType": "model/stl",
      "required": true
    },
    {
      "name": "model.glb",
      "mediaType": "model/gltf-binary",
      "required": false
    },
    {
      "name": "meta.json",
      "mediaType": "application/json",
      "required": true
    }
  ],
  "timeoutSeconds": 120,
  "memoryMb": 512,
  "networkPolicy": "deny",
  "inputSchema": "input.schema.json",
  "maxInputBytes": 131072,
  "maxOutputBytes": 10485760
}
