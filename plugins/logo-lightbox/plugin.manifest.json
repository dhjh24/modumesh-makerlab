{
  "schemaVersion": "1",
  "id": "logo-lightbox",
  "name": "Logo Light Box",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "engine": "python",
  "entrypoint": "logo_lightbox.plugin:run",
  "description": "Turn uploaded artwork into a custom LED light box. Upload SVG or PNG artwork, set dimensions and print options, and generate a face plate, enclosure, and back panel ready for printing.",
  "author": "MakerLab Team",
  "license": "MIT",
  "categories": ["cad", "parametric", "lighting", "signage"],
  "tags": ["light-box", "led", "logo", "sign", "svg"],
  "maturity": "experimental",
  "capabilities": {
    "preview": true,
    "deterministic": true,
    "multipart": true,
    "text": true,
    "imageUpload": true
  },
  "outputs": [
    {
      "name": "face.stl",
      "mediaType": "model/stl",
      "required": true,
      "purpose": "printable"
    },
    {
      "name": "enclosure.stl",
      "mediaType": "model/stl",
      "required": true,
      "purpose": "printable"
    },
    {
      "name": "back-panel.stl",
      "mediaType": "model/stl",
      "required": true,
      "purpose": "printable"
    },
    {
      "name": "preview.glb",
      "mediaType": "model/gltf-binary",
      "required": true,
      "purpose": "preview"
    },
    {
      "name": "thumbnail.png",
      "mediaType": "image/png",
      "required": false,
      "purpose": "thumbnail"
    },
    {
      "name": "design.json",
      "mediaType": "application/json",
      "required": true,
      "purpose": "metadata"
    },
    {
      "name": "validation-report.json",
      "mediaType": "application/json",
      "required": true,
      "purpose": "metadata"
    }
  ],
  "timeoutSeconds": 180,
  "memoryMb": 2048,
  "networkPolicy": "deny",
  "inputSchema": "input.schema.json",
  "maxInputBytes": 524288,
  "maxOutputBytes": 20971520
}
