{
  "schemaVersion": "1",
  "id": "triposr",
  "name": "TripoSR (fast image-to-3D)",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "engine": "python",
  "entrypoint": "triposr.plugin:run",
  "description": "Fast single-image-to-3D mesh generation using TripoSR. Produces a previewable mesh from one image on the documented GPU tier.",
  "author": "MakerLab Team",
  "license": "MIT",
  "categories": ["3d", "ai", "image-to-3d"],
  "tags": ["triposr", "image", "gpu", "fast"],
  "maturity": "experimental",
  "capabilities": { "preview": true, "imageUpload": true, "deterministic": false },
  "runtime": {
    "mode": "inprocess",
    "hardware": "gpu-low-fp16",
    "resources": { "memory_mb": { "min": 1024, "max": 4096 } },
    "privileged": false
  },
  "outputs": [
    {
      "name": "model.glb",
      "mediaType": "model/gltf-binary",
      "required": true,
      "purpose": "preview"
    },
    { "name": "model.stl", "mediaType": "model/stl", "required": false, "purpose": "printable" },
    {
      "name": "meta.json",
      "mediaType": "application/json",
      "required": true,
      "purpose": "metadata"
    }
  ],
  "timeoutSeconds": 120,
  "memoryMb": 4096,
  "networkPolicy": "deny",
  "inputSchema": "input.schema.json"
}
